{
  "$schema": "https://motiongit.com/schema/motion/0.1.json",
  "format": "motiongit-template",
  "specVersion": "0.1.0-draft.1",
  "template": {
    "id": "ai-cut-editorial-canvas",
    "version": "1.0.0",
    "name": "编辑画布式知识口播",
    "status": "candidate",
    "contentType": "motion-fragment"
  },
  "runtime": {
    "profile": "ai-cut.remotion/1",
    "engine": "Remotion",
    "engineVersion": "4.0.523",
    "entry": "render.mjs",
    "dependencyLock": "motion.lock.json"
  },
  "parameters": {
    "schema": "params.schema.json",
    "defaultPreset": "presets/demo.json"
  },
  "assets": {
    "manifest": "asset-manifest.json"
  },
  "output": {
    "width": 1080,
    "height": 1920,
    "fps": {
      "num": 30,
      "den": 1
    },
    "durationPolicy": "fit-content",
    "durationSeconds": 20
  },
  "license": {
    "file": "licenses/TEMPLATE-LICENSE.txt"
  },
  "permissions": {
    "network": false,
    "read": [
      "package",
      "instance-inputs"
    ],
    "write": [
      "instance-output"
    ]
  },
  "ai": {
    "entry": "SKILL.md",
    "guide": "guide.json",
    "authoring": {
      "tool": "codex",
      "client": "codex"
    }
  },
  "integrity": "integrity.json",
  "variants": [
    {
      "id": "paper-editorial",
      "name": "纸面编辑画布",
      "preset": "presets/demo.json",
      "swatch": "#FF5B22"
    },
    {
      "id": "dark-workbench",
      "name": "深色工作台",
      "preset": "presets/learning-landscape.json",
      "swatch": "#FFB94E"
    },
    {
      "id": "material-wall",
      "name": "蓝色素材墙",
      "preset": "presets/material-wall.json",
      "swatch": "#2D55FF"
    }
  ],
  "extensions": {
    "agi-top.com:editorial-canvas": {
      "version": "1",
      "outputFromInputs": {
        "aspect": "9:16|16:9",
        "duration": "sum(scenes.duration)"
      },
      "adapterContract": "render.mjs consumes --input --assets --out --chrome; silent H264/30fps, no network during render",
      "distribution": "author-content; not personal-download-v1"
    }
  }
}