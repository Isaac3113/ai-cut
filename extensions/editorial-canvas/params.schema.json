{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "duration",
    "aspect",
    "variant",
    "accent",
    "secondary",
    "paper",
    "ink",
    "label",
    "seed",
    "scenes",
    "captions"
  ],
  "properties": {
    "aspect": {
      "enum": [
        "9:16",
        "16:9"
      ]
    },
    "variant": {
      "enum": [
        "paper-editorial",
        "dark-workbench",
        "material-wall"
      ]
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9999
    },
    "presenter": {
      "type": "string",
      "maxLength": 240
    },
    "presenterType": {
      "enum": [
        "image",
        "video"
      ]
    },
    "presenterLabel": {
      "type": "string",
      "maxLength": 32
    },
    "presenterStart": {
      "type": "number",
      "minimum": 0
    },
    "font": {
      "type": "string",
      "maxLength": 240
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "title",
          "emphasis",
          "detail",
          "duration",
          "items"
        ],
        "properties": {
          "kind": {
            "enum": [
              "hook",
              "prompt",
              "shift",
              "flow",
              "gallery",
              "folder",
              "closing"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 26
          },
          "emphasis": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 70
          },
          "duration": {
            "type": "number",
            "minimum": 3,
            "maximum": 12
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "detail"
              ],
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 12
                },
                "detail": {
                  "type": "string",
                  "maxLength": 32
                },
                "media": {
                  "type": "string",
                  "maxLength": 240
                },
                "mediaType": {
                  "enum": [
                    "image",
                    "video"
                  ]
                },
                "sourceStart": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "flow"
                }
              }
            },
            "then": {
              "properties": {
                "items": {
                  "minItems": 2,
                  "items": {
                    "properties": {
                      "detail": {
                        "maxLength": 20
                      }
                    }
                  }
                }
              }
            },
            "else": {
              "properties": {
                "items": {
                  "maxItems": 3
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "hook"
                }
              }
            },
            "then": {
              "properties": {
                "items": {
                  "items": {
                    "properties": {
                      "title": {
                        "maxLength": 6
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "flow"
                },
                "items": {
                  "minItems": 4
                }
              }
            },
            "then": {
              "properties": {
                "duration": {
                  "minimum": 4
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "flow"
                },
                "items": {
                  "minItems": 5
                }
              }
            },
            "then": {
              "properties": {
                "duration": {
                  "minimum": 5
                }
              }
            }
          }
        ]
      }
    },
    "captions": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start",
          "end",
          "text"
        ],
        "properties": {
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 45
          }
        }
      }
    },
    "accent": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "secondary": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "paper": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "ink": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "duration": {
      "type": "number",
      "minimum": 3,
      "maximum": 120
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "aspect": {
            "const": "9:16"
          }
        }
      },
      "then": {
        "properties": {
          "captions": {
            "items": {
              "properties": {
                "text": {
                  "maxLength": 24
                }
              }
            }
          }
        }
      }
    }
  ]
}